@startuml
title CJM: Клиент оформляет заказ
start
:Открыть список заведений (GET /venues);
:Выбрать заведение;
:Просмотреть меню (GET /venues/{id}/menu);
if (Позиция в наличии?) then (да)
  :Добавить в корзину (на клиенте);
else (нет)
  :Показать "недоступно";
endif
:Оформить заказ (POST /orders);
if (Все позиции валидны и в наличии?) then (да)
  :Заказ создан, статус CREATED;
  :Опрос статуса (GET /orders/{id});
  repeat
    :Статус меняется заведением;
  repeat while (статус не финальный?) is (да)
  ->нет;
  :Заказ завершён (COMPLETED) или отменён (CANCELLED);
else (нет)
  :409 Conflict + список недоступных позиций;
  stop
endif
stop
@enduml
